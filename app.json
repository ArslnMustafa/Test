{
  "expo": {
    "name": "Darna",
    "slug": "darna",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0e1a",
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0a0e1a",
          "resizeMode": "contain"
        }
      ]
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.darna.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0a0e1a"
      }
    },
    "web": {
      "bundler": "metro"
    }
  }
}
